@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/aerospace-defence> a owl:Ontology ;
    dcterms:creator "Antigravity Engineering Swarm" ;
    dcterms:description "A formal enterprise-grade W3C OWL 2 ontology representing aerospace and defence ecosystems, multi-tier supply chains, Canadian ITB offset policies, NATO codifications, and hybrid procurement matching across Canada, the EU, and the UK."@en ;
    dcterms:title "Aerospace and Defence (A&D) Enterprise, Capability & Supply Chain Ontology"@en ;
    owl:versionInfo "2.0.0" .

aero:AutonomousSystemsCapability a owl:Class ;
    rdfs:label "Uncrewed & Autonomous Systems Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:AvionicsSensorCapability a owl:Class ;
    rdfs:label "Avionics, Radar & Sensor Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:Cert_CGP_Canada a aero:ExportComplianceStandard ;
    rdfs:label "Controlled Goods Program (CGP) Certified (Canada)"@en ;
    rdfs:comment "Mandatory Canadian industrial security program governing access to ITAR and controlled military items."@en .

aero:Cert_CyberEssentialsPlus a aero:SecurityClearanceStandard ;
    rdfs:label "Cyber Essentials Plus (UK MOD Mandate)"@en ;
    rdfs:comment "UK government-backed certification standard for cyber security."@en .

aero:Cert_DISP_Level2 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 2 - Protected (Australia)"@en .

aero:Cert_DISP_Level3 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 3 - Secret (Australia)"@en .

aero:Cert_FacilitySecurity_TopSecret a aero:SecurityClearanceStandard ;
    rdfs:label "Facility Security Clearance - Top Secret / Special Access Program"@en .

aero:Cert_ISO14001 a aero:QualityStandard ;
    rdfs:label "ISO 14001:2015 Environmental Management Standard"@en .

aero:Cert_NADCAP_Chemical a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Chemical Processing"@en .

aero:Cert_NADCAP_Composites a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Composites"@en .

aero:Cert_NADCAP_HeatTreating a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Heat Treating"@en .

aero:Cert_SCOMET_Compliant a aero:ExportComplianceStandard ;
    rdfs:label "Special Chemicals, Organisms, Materials, Equipment & Technologies (SCOMET) Export License (India)"@en .

