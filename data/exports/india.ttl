aero:Cap_1812A_1 a aero:Capability ;
    rdfs:label "Active Electronically Scanned Array (AESA) Radar Systems"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_SensorsSonar ;
    aero:capabilityDescription "Development and series manufacturing of solid-state active phased array airborne fire control radars (Uttam), ground air defence radars, and weapon locating radars."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1812A_2 a aero:Capability ;
    rdfs:label "Naval Integrated Sonar Suites and Acoustic Processing"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_SensorsSonar ;
    aero:capabilityDescription "Hull-mounted, towed array, and active/passive variable depth sonar systems (HUMSA-NG, USHUS-2) with advanced acoustic classification DSP architectures."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1812A_3 a aero:Capability ;
    rdfs:label "Tactical Electronic Warfare (EW) and ECM/ESM Suites"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_SensorsSonar ;
    aero:capabilityDescription "Wideband digital receivers, DRFM-based radar jammers, missile approach warning systems, and integrated defensive aids suites."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1824A_1 a aero:Capability ;
    rdfs:label "Guided Missile System Manufacturing & Final Integration"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_Munitions ;
    aero:capabilityDescription "Series production, seeker integration, propellant grain loading, and hardware-in-the-loop testing for air-to-air, surface-to-air, and anti-tank guided missiles."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1824A_2 a aero:Capability ;
    rdfs:label "Underwater Heavyweight and Lightweight Torpedoes"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_Munitions ;
    aero:capabilityDescription "Thermal propulsion, battery electric drive, acoustic homing seeker integration, and deep-submergence torpedo manufacturing."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1845A_1 a aero:Capability ;
    rdfs:label "Light Combat Aircraft (LCA Tejas) Prime Systems Integration"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_DefenceSystemsIntegration ;
    aero:capabilityDescription "Full lifecycle design, structural assembly, carbon-composite wing integration, fly-by-wire flight control integration, and flight testing of 4.5 generation supersonic fighter aircraft."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1845A_2 a aero:Capability ;
    rdfs:label "Military Gas Turbine Aeroengine Manufacturing & Licensed Overhaul"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AerospaceSystems ;
    aero:capabilityDescription "Indigenous engine co-development and licensed overhaul of AL-31FP turbofans, RD-33 engines, and Shakti helicopter turboshafts with single-crystal turbine blades."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1845A_3 a aero:Capability ;
    rdfs:label "Combat Helicopter Design & Production (LCH Prachand / ALH Dhruv)"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AerospaceSystems ;
    aero:capabilityDescription "High-altitude multi-role combat and utility helicopter engineering with composite airframes, integrated dynamic components, and glass cockpits."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1850A_1 a aero:Capability ;
    rdfs:label "Aerostructures and Primary Fuselage Subassembly Manufacturing"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AerospaceSystems ;
    aero:capabilityDescription "Manufacturing of complete composite and metallic fuselages for Boeing AH-64 Apache, empennages for C-130J, and primary structures for international military aircraft."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1850A_2 a aero:Capability ;
    rdfs:label "Tactical Military Transport Aircraft Final Assembly Line (C-295)"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AerospaceSystems ;
    aero:capabilityDescription "Establishment of India's first private sector final assembly line for full aircraft manufacturing, structural integration, and flight testing."^^xsd:string ;
    aero:mrlValue 8 ;
    aero:trlValue 8 .

aero:Cap_1850A_3 a aero:Capability ;
    rdfs:label "Wheeled Armoured Combat Vehicles and Remote Weapon Stations"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_ArmouredVehicles ;
    aero:capabilityDescription "8x8 wheeled amphibious combat vehicle engineering, high-hardness ballistic steel monocoque hull fabrication, and stabilized weapon station integration."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1876A_1 a aero:Capability ;
    rdfs:label "Submarine Pressure Hull Construction and Heavy Mechanical Systems"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_NavalShipbuilding ;
    aero:capabilityDescription "High-strength HSLA steel precision forming, narrow-gap robotic welding, acoustic vibration isolation, and submarine modular build."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1876A_2 a aero:Capability ;
    rdfs:label "Tracked Self-Propelled Artillery Systems (K9 Vajra-T)"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_ArmouredVehicles ;
    aero:capabilityDescription "Full indigenous manufacturing, chassis welding, 155mm/52 caliber gun turret integration, and fire control ballistic computer engineering."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1876A_3 a aero:Capability ;
    rdfs:label "Naval Missile Launchers and Weapon Handling Systems"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_NavalShipbuilding ;
    aero:capabilityDescription "Universal vertical launch system (UVLS) modules, torpedo tube launchers, and automated anti-submarine rocket decoy launchers."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1910A_1 a aero:Capability ;
    rdfs:label "Global Commercial & Military Aircraft Control Surface Assemblies"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AerospaceSystems ;
    aero:capabilityDescription "Single-source manufacturing of empennage structures, aft pylon assemblies for Boeing P-8 Poseidon, and flap track fairings for Airbus."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1910A_2 a aero:Capability ;
    rdfs:label "High-Precision Thin-Wall Titanium & Aluminium Aerostructure Machining"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AdvancedMaterials ;
    aero:capabilityDescription "Complex high-speed 5-axis machining of aircraft bulkheads, titanium fittings, and structural beams with tolerances below 10 microns."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1925A_1 a aero:Capability ;
    rdfs:label "Multi-Spectral Electro-Optical and Thermal Night Vision Systems"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_EOIRSystems ;
    aero:capabilityDescription "Cooled and uncooled long-wave (LWIR) and mid-wave infrared (MWIR) imaging engines, optical computational cameras, and panoramic vehicle driver sights."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1925A_2 a aero:Capability ;
    rdfs:label "AI Target Detection, Tracking and Video Fire Control"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_AIAutonomousSystems ;
    aero:capabilityDescription "Edge-computed real-time computer vision algorithms for automated target classification, moving target indication (MTI), and ballistic fire solutions."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1938A_1 a aero:Capability ;
    rdfs:label "Space-Grade Large Aperture Optics & Beryllium Mirrors"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_SpaceSystems ;
    aero:capabilityDescription "Precision ultra-lightweight beryllium mirror fabrication, zero-expansion glass ceramics optical polishing, and space camera payload telescopes."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1938A_2 a aero:Capability ;
    rdfs:label "Electromagnetic Pulse (EMP) Shielding and High-Power Microwave Protection"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_CyberResilience ;
    aero:capabilityDescription "Full EMP / HEMP MIL-STD-188-125 shielded enclosures, power and signal line surge suppression filters, and TEMPEST server racks."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1947A_1 a aero:Capability ;
    rdfs:label "Synthetic Warfighter Combat Simulation and Virtual Live-Fire Ranges"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_TrainingSimulation ;
    aero:capabilityDescription "Distributed virtual reality combat training simulators, tank crew gunnery simulators, smart indoor live-fire target systems, and air defence combat training systems."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1947A_2 a aero:Capability ;
    rdfs:label "Counter-Unmanned Aerial Systems (C-UAS) and Drone Hard/Soft Kill"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_RemotelyPilotedSystems ;
    aero:capabilityDescription "Multi-sensor drone detection (RF detector, 3D radar, EO/IR camera tracking) and multi-band RF/GNSS jamming and hard-kill drone neutralization."^^xsd:string ;
    aero:mrlValue 9 ;
    aero:trlValue 9 .

aero:Cap_1955A_1 a aero:Capability ;
    rdfs:label "Tactical Vertical Take-Off & Landing (VTOL) Military Surveillance Drones"^^xsd:string ;
    aero:alignedWithKIC aero:KIC_RemotelyPilotedSystems ;
