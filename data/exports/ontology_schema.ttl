@prefix aero: <https://w3id.org/aerospace-defence#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/aerospace-defence> a owl:Ontology ;
    dcterms:creator "Antigravity Engineering Swarm" ;
    dcterms:description "A formal enterprise-grade W3C OWL 2 ontology representing aerospace and defence ecosystems, multi-tier supply chains, Canadian ITB offset policies, NATO codifications, and hybrid procurement matching across Canada, the EU, and the UK."@en ;
    dcterms:title "Aerospace and Defence (A&D) Enterprise, Capability & Supply Chain Ontology"@en ;
    owl:versionInfo "2.0.0" .

aero:AutonomousSystemsCapability a owl:Class ;
    rdfs:label "Uncrewed & Autonomous Systems Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:AvionicsSensorCapability a owl:Class ;
    rdfs:label "Avionics, Radar & Sensor Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:Cert_AS9100D a aero:QualityStandard ;
    rdfs:label "AS9100 Rev D (Quality Management Systems - Aerospace)"@en ;
    rdfs:comment "Standardized quality management system for the aviation, space, and defense industry."@en ;
    skos:altLabel "EN 9100:2018" .

aero:Cert_AS9110C a aero:QualityStandard ;
    rdfs:label "AS9110 Rev C (Aerospace Maintenance Organization Quality Management)"@en ;
    rdfs:comment "Aerospace quality management system standard specifically for maintenance, repair, and overhaul (MRO) organizations."@en ;
    skos:altLabel "AS9110" .

aero:Cert_AS9120B a aero:QualityStandard ;
    rdfs:label "AS9120 Rev B (Aerospace Stockist and Distributor Quality Management)"@en ;
    rdfs:comment "Quality management standard for aerospace pass-through distributors, stockists, and supply chain logistics providers."@en ;
    skos:altLabel "AS9120" .

aero:Cert_CGP_Canada a aero:ExportComplianceStandard ;
    rdfs:label "Controlled Goods Program (CGP) Certified (Canada)"@en ;
    rdfs:comment "Mandatory Canadian industrial security program governing access to ITAR and controlled military items."@en .

aero:Cert_CMMC_Level2 a aero:SecurityClearanceStandard ;
    rdfs:label "CMMC Level 2 (Cybersecurity Maturity Model Certification)"@en .

aero:Cert_CMMC_Level3 a aero:SecurityClearanceStandard ;
    rdfs:label "CMMC Level 3 (Cybersecurity Maturity Model Certification - Expert / Enhanced)"@en ;
    rdfs:comment "DoD Cybersecurity Maturity Model Certification Level 3 aligned with NIST SP 800-172 for critical defence programs and APT resilience."@en ;
    skos:altLabel "CMMC L3" .

aero:Cert_CyberEssentialsPlus a aero:SecurityClearanceStandard ;
    rdfs:label "Cyber Essentials Plus (UK MOD Mandate)"@en ;
    rdfs:comment "UK government-backed certification standard for cyber security."@en .

aero:Cert_DFARS_NIST800171 a aero:SecurityClearanceStandard ;
    rdfs:label "DFARS 252.204-7012 / NIST SP 800-171 CUI Compliance"@en ;
    rdfs:comment "US Department of Defense Defense Federal Acquisition Regulation Supplement requirement for safeguarding Covered Defense Information (CDI / CUI)."@en ;
    skos:altLabel "DFARS 7012",
        "NIST SP 800-171" .

aero:Cert_DISP_Level2 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 2 - Protected (Australia)"@en .

aero:Cert_DISP_Level3 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 3 - Secret (Australia)"@en .

aero:Cert_ESA_Qualified a aero:QualityStandard ;
    rdfs:label "European Space Agency (ESA) Flight Hardware Qualified"@en .

aero:Cert_FAA_Part145 a aero:QualityStandard ;
    rdfs:label "FAA Part 145 Certified Repair Station (14 CFR Part 145)"@en ;
    rdfs:comment "Federal Aviation Administration repair station certification for airframe, powerplant, propeller, radio, instrument, and accessory maintenance."@en ;
    skos:altLabel "FAA Part 145" .

aero:Cert_FAA_TSO_Certified a aero:QualityStandard ;
    rdfs:label "FAA Technical Standard Order (TSO) Authorization"@en .

aero:Cert_FacilitySecurity_Secret a aero:SecurityClearanceStandard ;
    rdfs:label "Facility Security Clearance - NATO / National Secret Level"@en .

aero:Cert_FacilitySecurity_TopSecret a aero:SecurityClearanceStandard ;
    rdfs:label "Facility Security Clearance - Top Secret / Special Access Program"@en .

aero:Cert_ISO14001 a aero:QualityStandard ;
    rdfs:label "ISO 14001:2015 Environmental Management Standard"@en .

aero:Cert_ISO27001 a aero:SecurityClearanceStandard ;
    rdfs:label "ISO/IEC 27001 Information Security Management"@en .

aero:Cert_ISO9001 a aero:QualityStandard ;
    rdfs:label "ISO 9001:2015 Quality Management System"@en .

aero:Cert_ITAR_Compliant a aero:ExportComplianceStandard ;
    rdfs:label "ITAR / EAR Export Control Compliant"@en ;
    rdfs:comment "International Traffic in Arms Regulations compliance posture."@en .

aero:Cert_NADCAP_Chemical a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Chemical Processing"@en .

aero:Cert_NADCAP_Composites a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Composites"@en .

aero:Cert_NADCAP_HeatTreating a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Heat Treating"@en .

aero:Cert_NADCAP_NDT a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Non-Destructive Testing (NDT)"@en .

aero:Cert_NADCAP_Welding a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Welding & Additive Manufacturing"@en .

aero:Cert_NASA_Approved a aero:QualityStandard ;
    rdfs:label "NASA Flight Hardware & Mission Assurance Approved Supplier"@en .

aero:Cert_NATO_AQAP2110 a aero:QualityStandard ;
    rdfs:label "NATO AQAP 2110 (Design, Development and Production)"@en ;
    rdfs:comment "Allied Quality Assurance Publications standard for NATO defence materiel."@en .

aero:Cert_SCOMET_Compliant a aero:ExportComplianceStandard ;
    rdfs:label "Special Chemicals, Organisms, Materials, Equipment & Technologies (SCOMET) Export License (India)"@en .

aero:CyberC4ISRCapability a owl:Class ;
    rdfs:label "Cyber, C4ISR & Tactical Communications Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:CyberSecurityService a owl:Class ;
    rdfs:label "Defence Cyber Security & Penetration Testing Service"@en ;
    rdfs:subClassOf aero:Service .

aero:EngineeringService a owl:Class ;
    rdfs:label "Systems & Design Engineering Service"@en ;
    rdfs:subClassOf aero:Service .

aero:KIC_AIAutonomousSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Machine learning algorithms, autonomous navigation, mission management systems, and swarm coordination."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Artificial Intelligence and Autonomous Technologies"@en .

aero:KIC_AdvancedMaterials a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Lightweight composites, high-temperature alloys, metamaterials, and protective ballistic materials."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Advanced Materials"@en .

aero:KIC_AerospaceSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Aerostructures, landing gear, propulsion components, environmental systems, and flight controls."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Aerospace Systems and Components"@en .

aero:KIC_ArmouredVehicles a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Wheeled and tracked light/medium armoured combat vehicles, survivability, and lethality integration."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Armoured Vehicles and Combat Support Systems"@en .

aero:KIC_CBRNDefence a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Chemical, Biological, Radiological, and Nuclear detection, decontamination, and protective equipment."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "CBRN Defence and Protection"@en .

aero:KIC_CyberResilience a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Military-grade encryption, defensive cyber operations, tactical network hardening, and zero-trust architectures."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Cyber Resilience and Cryptography"@en .

aero:KIC_DefenceSystemsIntegration a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Prime architecture, mission system integration, multi-domain command and control (C2), and interoperability."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Defence Systems Integration"@en .

aero:KIC_EOIRSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Targeting turrets, FLIR sensors, laser rangefinders, night vision, and hyperspectral imaging."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Electro-Optical and Infrared (EO/IR) Systems"@en .

aero:KIC_InServiceSupport a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Comprehensive lifecycle management, aircraft depot-level overhaul, structural integrity, and modernization."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "In-Service Support (ISS) and Fleet Life Extension"@en .

aero:KIC_Munitions a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Small, medium, and large caliber ammunition, guided munitions, propellants, and warheads."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Munitions, Energetics and Pyrotechnics"@en .

aero:KIC_NavalShipbuilding a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Surface combatant construction, submarine maintenance, propulsion integration, and sonars."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Naval Ship Construction, Modernization and Subsea Systems"@en .

aero:KIC_RemotelyPilotedSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Tactical, MALE, and micro UAS airframes, ground control stations, and datalinks."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Remotely Piloted Aircraft and Uncrewed Aerial Systems (UAS)"@en .

aero:KIC_SensorsSonar a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "AESA radar, active/passive dipping sonars, sonobuoys, electronic surveillance measures, and acoustics."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Sensor, Radar, and Sonar Systems"@en .

aero:KIC_SoftwareDefinedRadio a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Interoperable tactical communications, satellite communication terminals, Link 16, and secure waveform generation."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Software-Defined Radios and Tactical Communications"@en .

aero:KIC_SpaceSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Synthetic Aperture Radar (SAR) satellites, space robotics, Earth observation payloads, and satellite bus subsystems."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Space Systems and Space Exploration Technologies"@en .

aero:KIC_TrainingSimulation a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Level D full flight simulators, distributed mission training, virtual reality cockpits, and live-virtual-constructive (LVC) environments."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Training Systems and Synthetic Simulation"@en .

aero:LogisticsSupportService a owl:Class ;
    rdfs:label "Integrated Logistics & In-Service Fleet Support Service"@en ;
    rdfs:subClassOf aero:Service .

aero:MROService a owl:Class ;
    rdfs:label "Maintenance, Repair & Overhaul (MRO) Service"@en ;
    rdfs:subClassOf aero:Service .

aero:ManufacturingCapability a owl:Class ;
    rdfs:label "Advanced Manufacturing Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:Material_AluminiumLithium_2055 a aero:CriticalMaterial ;
    rdfs:label "Aluminium-Lithium Alloy 2055 / 2195 (Aerospace & Cryogenic Tankage)"@en ;
    skos:definition "Low-density, high-stiffness aluminium-lithium structural alloy used in fighter fuselages, cryogenic rocket propellant tanks, and naval hulls."@en .

aero:Material_Beryllium_Optical a aero:CriticalMaterial ;
    rdfs:label "Optical & Aerospace Grade Beryllium (O-30 / I-220H)"@en ;
    skos:definition "Ultra-stiff, lightweight metal for space telescope mirrors, EO/IR gimbal housings, inertial guidance gyros, and nuclear/missile structures."@en .

aero:Material_CarbonFiber_Composite a aero:CriticalMaterial ;
    rdfs:label "Intermediate Modulus Carbon Fiber / Toughened Epoxy Composite"@en ;
    skos:definition "High-tensile carbon fiber reinforcement with toughened epoxy matrix for stealth airframes and supersonic wing skins."@en .

aero:Material_GalliumNitride_GaN a aero:CriticalMaterial ;
    rdfs:label "Gallium Nitride on Silicon Carbide (GaN-on-SiC) Semiconductor"@en ;
    skos:definition "Wide-bandgap semiconductor enabling high-power, high-frequency AESA radar transmit/receive modules and EW jamming apertures."@en .

aero:Material_HighPurity_Beryllium a aero:CriticalMaterial ;
    rdfs:label "High-Purity Beryllium Aerospace Grade"@en ;
    skos:definition "High-purity structural and optical beryllium for precision targeting optics and space systems."@en .

aero:Material_Inconel_718 a aero:CriticalMaterial ;
    rdfs:label "Inconel 718 Nickel-Chromium Superalloy"@en ;
    skos:definition "Precipitation-hardenable nickel-chromium superalloy for high-temperature turbine disks, rocket engine combustors, and fasteners."@en .

aero:Material_Kevlar_Aramid a aero:CriticalMaterial ;
    rdfs:label "Kevlar / Para-Aramid Ballistic Fiber"@en ;
    skos:definition "Synthetic aromatic polyamide fiber delivering superior energy absorption for spall liners, body armour, and rotor containment."@en .

aero:Material_RadarAbsorbentMaterial_RAM a aero:CriticalMaterial ;
    rdfs:label "Radar Absorbent Material (RAM) & Low-Observable Coatings"@en ;
    skos:definition "Electromagnetic wave-attenuating stealth coatings and structural radar-absorbing composites for 5th/6th-generation combat aircraft."@en .

aero:Material_RareEarth_Neodymium a aero:CriticalMaterial ;
    rdfs:label "Neodymium-Iron-Boron (NdFeB) & Samarium-Cobalt Rare Earth Magnets"@en ;
    skos:definition "Sintered rare-earth permanent magnets essential for missile fin actuators, F-35 electric actuation, sonar transducers, and TWT/radar amplifiers."@en .

aero:Material_Rhenium_Refractory a aero:CriticalMaterial ;
    rdfs:label "Rhenium Refractory Metal & Superalloy Additive"@en ;
    skos:definition "Ultra-high melting point refractory metal critical for rocket thruster nozzles, hypersonic leading edges, and single-crystal turbine blades."@en .

aero:Material_SiliconCarbide_SiC a aero:CriticalMaterial ;
    rdfs:label "Silicon Carbide (SiC) Ceramic Matrix Composite"@en ;
    skos:definition "Ceramic matrix composite for ultra-high temperature engine hot sections, hypersonic thermal protection, and space optics."@en .

aero:Material_SingleCrystal_Superalloy a aero:CriticalMaterial ;
    rdfs:label "Single-Crystal High-Pressure Turbine Nickel Superalloy"@en ;
    skos:definition "Second and third generation single-crystal superalloy with Rhenium/Ruthenium additions for extreme thermal operating margins."@en .

aero:Material_Titanium_Ti6Al4V a aero:CriticalMaterial ;
    rdfs:label "Titanium Alloy Ti-6Al-4V (Grade 5 Aerospace)"@en ;
    skos:definition "High strength-to-weight ratio titanium alloy used in primary airframe structures, landing gears, and turbine compressors."@en .

aero:Material_Tungsten_HeavyAlloy a aero:CriticalMaterial ;
    rdfs:label "Tungsten Heavy Alloy (WHA) & Kinetic Penetrator Material"@en ;
    skos:definition "High-density tungsten alloy used in armor-piercing kinetic energy penetrators, fragmentation warheads, radiation shielding, and counterweights."@en .

