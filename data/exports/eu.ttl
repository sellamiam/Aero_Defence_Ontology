aero:CyberC4ISRCapability a owl:Class ;
    rdfs:label "Cyber, C4ISR & Tactical Communications Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:CyberSecurityService a owl:Class ;
    rdfs:label "Defence Cyber Security & Penetration Testing Service"@en ;
    rdfs:subClassOf aero:Service .

aero:KIC_AdvancedMaterials a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Lightweight composites, high-temperature alloys, metamaterials, and protective ballistic materials."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Advanced Materials"@en .

aero:KIC_CBRNDefence a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Chemical, Biological, Radiological, and Nuclear detection, decontamination, and protective equipment."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "CBRN Defence and Protection"@en .

aero:KIC_CyberResilience a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Military-grade encryption, defensive cyber operations, tactical network hardening, and zero-trust architectures."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Cyber Resilience and Cryptography"@en .

aero:KIC_EOIRSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Targeting turrets, FLIR sensors, laser rangefinders, night vision, and hyperspectral imaging."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Electro-Optical and Infrared (EO/IR) Systems"@en .

aero:KIC_InServiceSupport a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Comprehensive lifecycle management, aircraft depot-level overhaul, structural integrity, and modernization."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "In-Service Support (ISS) and Fleet Life Extension"@en .

aero:KIC_RemotelyPilotedSystems a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Tactical, MALE, and micro UAS airframes, ground control stations, and datalinks."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Remotely Piloted Aircraft and Uncrewed Aerial Systems (UAS)"@en .

aero:KIC_SoftwareDefinedRadio a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Interoperable tactical communications, satellite communication terminals, Link 16, and secure waveform generation."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Software-Defined Radios and Tactical Communications"@en .

aero:KIC_TrainingSimulation a skos:Concept,
        aero:KeyIndustrialCapability ;
    skos:definition "Level D full flight simulators, distributed mission training, virtual reality cockpits, and live-virtual-constructive (LVC) environments."@en ;
    skos:inScheme aero:KICScheme ;
    skos:prefLabel "Training Systems and Synthetic Simulation"@en .

aero:ManufacturingCapability a owl:Class ;
    rdfs:label "Advanced Manufacturing Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:Material_AluminiumLithium_2055 a aero:CriticalMaterial ;
    rdfs:label "Aluminium-Lithium Alloy 2055 / 2195 (Aerospace & Cryogenic Tankage)"@en ;
    skos:definition "Low-density, high-stiffness aluminium-lithium structural alloy used in fighter fuselages, cryogenic rocket propellant tanks, and naval hulls."@en .

aero:Material_Beryllium_Optical a aero:CriticalMaterial ;
    rdfs:label "Optical & Aerospace Grade Beryllium (O-30 / I-220H)"@en ;
    skos:definition "Ultra-stiff, lightweight metal for space telescope mirrors, EO/IR gimbal housings, inertial guidance gyros, and nuclear/missile structures."@en .

aero:Material_Inconel_718 a aero:CriticalMaterial ;
    rdfs:label "Inconel 718 Nickel-Chromium Superalloy"@en ;
    skos:definition "Precipitation-hardenable nickel-chromium superalloy for high-temperature turbine disks, rocket engine combustors, and fasteners."@en .

aero:Material_RadarAbsorbentMaterial_RAM a aero:CriticalMaterial ;
    rdfs:label "Radar Absorbent Material (RAM) & Low-Observable Coatings"@en ;
    skos:definition "Electromagnetic wave-attenuating stealth coatings and structural radar-absorbing composites for 5th/6th-generation combat aircraft."@en .

aero:Material_RareEarth_Neodymium a aero:CriticalMaterial ;
    rdfs:label "Neodymium-Iron-Boron (NdFeB) & Samarium-Cobalt Rare Earth Magnets"@en ;
    skos:definition "Sintered rare-earth permanent magnets essential for missile fin actuators, F-35 electric actuation, sonar transducers, and TWT/radar amplifiers."@en .

aero:Material_Rhenium_Refractory a aero:CriticalMaterial ;
    rdfs:label "Rhenium Refractory Metal & Superalloy Additive"@en ;
    skos:definition "Ultra-high melting point refractory metal critical for rocket thruster nozzles, hypersonic leading edges, and single-crystal turbine blades."@en .

aero:Material_SiliconCarbide_SiC a aero:CriticalMaterial ;
    rdfs:label "Silicon Carbide (SiC) Ceramic Matrix Composite"@en ;
    skos:definition "Ceramic matrix composite for ultra-high temperature engine hot sections, hypersonic thermal protection, and space optics."@en .

aero:Material_Tungsten_HeavyAlloy a aero:CriticalMaterial ;
    rdfs:label "Tungsten Heavy Alloy (WHA) & Kinetic Penetrator Material"@en ;
    skos:definition "High-density tungsten alloy used in armor-piercing kinetic energy penetrators, fragmentation warheads, radiation shielding, and counterweights."@en .

aero:MaterialsCapability a owl:Class ;
    rdfs:label "Materials & Processing Capability"@en ;
    rdfs:subClassOf aero:Capability .

