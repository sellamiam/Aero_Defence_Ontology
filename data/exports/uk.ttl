<https://w3id.org/aerospace-defence> a owl:Ontology ;
    dcterms:creator "Antigravity Engineering Swarm" ;
    dcterms:description "A formal enterprise-grade W3C OWL 2 ontology representing aerospace and defence ecosystems, multi-tier supply chains, Canadian ITB offset policies, NATO codifications, and hybrid procurement matching across Canada, the EU, and the UK."@en ;
    dcterms:title "Aerospace and Defence (A&D) Enterprise, Capability & Supply Chain Ontology"@en ;
    owl:versionInfo "2.0.0" .

aero:AutonomousSystemsCapability a owl:Class ;
    rdfs:label "Uncrewed & Autonomous Systems Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:AvionicsSensorCapability a owl:Class ;
    rdfs:label "Avionics, Radar & Sensor Capability"@en ;
    rdfs:subClassOf aero:Capability .

aero:Cert_AS9110C a aero:QualityStandard ;
    rdfs:label "AS9110 Rev C (Aerospace Maintenance Organization Quality Management)"@en ;
    rdfs:comment "Aerospace quality management system standard specifically for maintenance, repair, and overhaul (MRO) organizations."@en ;
    skos:altLabel "AS9110" .

aero:Cert_AS9120B a aero:QualityStandard ;
    rdfs:label "AS9120 Rev B (Aerospace Stockist and Distributor Quality Management)"@en ;
    rdfs:comment "Quality management standard for aerospace pass-through distributors, stockists, and supply chain logistics providers."@en ;
    skos:altLabel "AS9120" .

aero:Cert_CGP_Canada a aero:ExportComplianceStandard ;
    rdfs:label "Controlled Goods Program (CGP) Certified (Canada)"@en ;
    rdfs:comment "Mandatory Canadian industrial security program governing access to ITAR and controlled military items."@en .

aero:Cert_CMMC_Level2 a aero:SecurityClearanceStandard ;
    rdfs:label "CMMC Level 2 (Cybersecurity Maturity Model Certification)"@en .

aero:Cert_CMMC_Level3 a aero:SecurityClearanceStandard ;
    rdfs:label "CMMC Level 3 (Cybersecurity Maturity Model Certification - Expert / Enhanced)"@en ;
    rdfs:comment "DoD Cybersecurity Maturity Model Certification Level 3 aligned with NIST SP 800-172 for critical defence programs and APT resilience."@en ;
    skos:altLabel "CMMC L3" .

aero:Cert_DFARS_NIST800171 a aero:SecurityClearanceStandard ;
    rdfs:label "DFARS 252.204-7012 / NIST SP 800-171 CUI Compliance"@en ;
    rdfs:comment "US Department of Defense Defense Federal Acquisition Regulation Supplement requirement for safeguarding Covered Defense Information (CDI / CUI)."@en ;
    skos:altLabel "DFARS 7012",
        "NIST SP 800-171" .

aero:Cert_DISP_Level2 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 2 - Protected (Australia)"@en .

aero:Cert_DISP_Level3 a aero:SecurityClearanceStandard ;
    rdfs:label "Defence Industry Security Program (DISP) Level 3 - Secret (Australia)"@en .

aero:Cert_ESA_Qualified a aero:QualityStandard ;
    rdfs:label "European Space Agency (ESA) Flight Hardware Qualified"@en .

aero:Cert_FAA_Part145 a aero:QualityStandard ;
    rdfs:label "FAA Part 145 Certified Repair Station (14 CFR Part 145)"@en ;
    rdfs:comment "Federal Aviation Administration repair station certification for airframe, powerplant, propeller, radio, instrument, and accessory maintenance."@en ;
    skos:altLabel "FAA Part 145" .

aero:Cert_FAA_TSO_Certified a aero:QualityStandard ;
    rdfs:label "FAA Technical Standard Order (TSO) Authorization"@en .

aero:Cert_ISO14001 a aero:QualityStandard ;
    rdfs:label "ISO 14001:2015 Environmental Management Standard"@en .

aero:Cert_ISO27001 a aero:SecurityClearanceStandard ;
    rdfs:label "ISO/IEC 27001 Information Security Management"@en .

aero:Cert_ITAR_Compliant a aero:ExportComplianceStandard ;
    rdfs:label "ITAR / EAR Export Control Compliant"@en ;
    rdfs:comment "International Traffic in Arms Regulations compliance posture."@en .

aero:Cert_NADCAP_Chemical a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Chemical Processing"@en .

aero:Cert_NADCAP_HeatTreating a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Heat Treating"@en .

aero:Cert_NADCAP_Welding a aero:QualityStandard ;
    rdfs:label "NADCAP Accreditation - Welding & Additive Manufacturing"@en .

aero:Cert_NASA_Approved a aero:QualityStandard ;
    rdfs:label "NASA Flight Hardware & Mission Assurance Approved Supplier"@en .

aero:Cert_SCOMET_Compliant a aero:ExportComplianceStandard ;
    rdfs:label "Special Chemicals, Organisms, Materials, Equipment & Technologies (SCOMET) Export License (India)"@en .

